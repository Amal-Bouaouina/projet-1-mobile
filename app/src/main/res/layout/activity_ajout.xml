<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F5F5">

    <!-- Barre du haut avec Titre et Bouton Retour -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">



        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ajouter un contact"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Espace vide pour équilibrer le centrage du titre -->
        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <!-- Champ Nom -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nom"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="5dp"/>

    <EditText
        android:id="@+id/ednom_ajout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Entrez le nom"
        android:inputType="textPersonName"
        android:backgroundTint="#4CAF50"
        android:layout_marginBottom="15dp"/>

    <!-- Champ Prénom -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Prénom"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="5dp"/>

    <EditText
        android:id="@+id/edpseudo_ajout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Entrez le prénom"
        android:inputType="textPersonName"
        android:backgroundTint="#4CAF50"
        android:layout_marginBottom="15dp"/>

    <!-- Champ Numéro -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Numéro"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="5dp"/>

    <EditText
        android:id="@+id/ednumero_ajout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Entrez le numéro"
        android:inputType="phone"
        android:backgroundTint="#4CAF50"
        android:layout_marginBottom="30dp"/>

    <!-- Boutons Valider et Annuler -->
    <Button
        android:id="@+id/btnvalider_ajout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Valider"
        android:backgroundTint="#4CAF50"
        android:textColor="@android:color/white"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnannuler_ajout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Annuler"
        android:backgroundTint="#E32424"
        android:textColor="@android:color/white"/>

</LinearLayout>